#!/usr/bin/env bash
# =============================================================================
#  Hook 0450 — Firewall rules persistence
#  INPUT policy DROP; opens SSH (22), AuxiNux web panel (8441), HTTP (80, for
#  Let's Encrypt challenge) and HTTPS (443), plus the guest bridges. Rules are
#  generated by virtuaos-firewall and made persistent through
#  iptables-persistent / netfilter-persistent.
# =============================================================================
set -euo pipefail

echo "[VirtuaOS] Configuring firewall (INPUT DROP; open 22, 80, 443, 8441)…"

# The iptables-persistent postinst normally prompts to save current rules.
# Pre-seed debconf so it installs non-interactively.
echo "iptables-persistent iptables-persistent/autosave_v4 boolean false" | debconf-set-selections
echo "iptables-persistent iptables-persistent/autosave_v6 boolean false" | debconf-set-selections

DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    iptables-persistent netfilter-persistent 2>&1 | tail -5

# ── Ruleset ──────────────────────────────────────────────────────────────────
# INPUT policy DROP (the old ruleset kept INPUT ACCEPT, so the "open" rules had
# no effect and every port was reachable). Accept rules live in a dedicated
# VIRTUAOS-INPUT chain generated by virtuaos-firewall from
# /etc/virtuaos/firewall.conf — edit that file, then `virtuaos-firewall apply`.
mkdir -p /etc/virtuaos
if [[ ! -f /etc/virtuaos/firewall.conf ]]; then
    cat > /etc/virtuaos/firewall.conf <<'EOF'
# VirtuaOS host firewall — apply changes with:  sudo virtuaos-firewall apply
# Ports open to everyone (3390-3489 = per-VM RDP consoles of the Virtua panel;
# the effective sshd port is always added):
ALLOW_TCP="22 80 443 8441 3390:3489"
ALLOW_UDP=""
# Guest bridges (DHCP/DNS served by the host to VMs / LXC / Docker):
TRUSTED_IFACES="virbr+ lxcbr+ docker0 br-+"
# Networks allowed on ALL ports (other cluster nodes, admin LAN), e.g.
# TRUSTED_SOURCES="10.0.0.0/24 192.168.1.10"
TRUSTED_SOURCES=""
EOF
    chmod 0644 /etc/virtuaos/firewall.conf
fi
bash /usr/local/sbin/virtuaos-firewall write

# Ensure the persistence service runs at boot.
systemctl enable netfilter-persistent.service 2>/dev/null || true

echo "[VirtuaOS] Firewall rules written + netfilter-persistent enabled."
