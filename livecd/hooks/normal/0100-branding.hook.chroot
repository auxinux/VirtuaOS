#!/usr/bin/env bash
# =============================================================================
#  Hook 0100 — VirtuaOS system branding
#  Sets OS identity, login messages, and hostname.
# =============================================================================
set -euo pipefail

VIRTUAOS_VERSION="1.0.4"

echo "[VirtuaOS] Applying system branding…"

# ── /etc/os-release ──────────────────────────────────────────────────────────
# On Debian 13 /etc/os-release is a symlink to /usr/lib/os-release, a plain file
# of base-files: every base-files upgrade (13.x point release) would put the
# Debian identity back (ID=debian) and `vos os` would stop recognising the host.
# Divert it so base-files installs its copy as /usr/lib/os-release.debian.
if ! dpkg-divert --list /usr/lib/os-release 2>/dev/null | grep -q os-release; then
    dpkg-divert --local --rename --divert /usr/lib/os-release.debian --add /usr/lib/os-release
fi
[[ -L /etc/os-release ]] || ln -sf ../usr/lib/os-release /etc/os-release
cat > /usr/lib/os-release <<EOF
PRETTY_NAME="VirtuaOS ${VIRTUAOS_VERSION} (Debian 13 Trixie)"
NAME="VirtuaOS"
VERSION="${VIRTUAOS_VERSION}"
VERSION_ID="${VIRTUAOS_VERSION}"
VERSION_CODENAME="trixie"
ID="virtuaos"
ID_LIKE="debian"
HOME_URL="https://auxinux.io"
SUPPORT_URL="https://auxinux.io/support"
BUG_REPORT_URL="https://github.com/auxinux/virtuaos/issues"
DEBIAN_CODENAME="trixie"
BUILD_ID="$(date -u +%Y%m%d)"
EOF

# Release marker: FULL version, pre-release suffix included (1.0.4-BETA), so
# `vos os` can tell a BETA from the final release.
printf '%s\n' "${VIRTUAOS_VERSION}" > /etc/virtuaos-version
printf 'VIRTUAOS_VERSION=%s\n' "${VIRTUAOS_VERSION}" > /etc/virtuaos-release
chmod 0644 /etc/virtuaos-version /etc/virtuaos-release

# Update channels shared with `vos channel` and the Virtua panel.
mkdir -p /etc/virtuaos
printf 'VIRTUAOS_CHANNEL=PROD\nKERNEL_CHANNEL=PROD\n' > /etc/virtuaos/channel
chmod 0644 /etc/virtuaos/channel

# /etc/debian_version is left to base-files (it is one of its conffiles —
# overwriting it only produced a dpkg prompt and a stale value).

# ── Hostname ─────────────────────────────────────────────────────────────────
echo "virtuaos" > /etc/hostname

cat > /etc/hosts <<'HOSTS'
127.0.0.1   localhost
127.0.1.1   virtuaos.local virtuaos
::1         localhost ip6-localhost ip6-loopback
ff02::1     ip6-allnodes
ff02::2     ip6-allrouters
HOSTS

# ── /etc/issue (shown before login prompt) ───────────────────────────────────
cat > /etc/issue <<'ISSUE'

  ██╗   ██╗██╗██████╗ ████████╗██╗   ██╗ █████╗  ██████╗ ███████╗
  ██║   ██║██║██╔══██╗╚══██╔══╝██║   ██║██╔══██╗██╔═══██╗██╔════╝
  ██║   ██║██║██████╔╝   ██║   ██║   ██║███████║██║   ██║███████╗
  ╚██╗ ██╔╝██║██╔══██╗   ██║   ██║   ██║██╔══██║██║   ██║╚════██║
   ╚████╔╝ ██║██║  ██║   ██║   ╚██████╔╝██║  ██║╚██████╔╝███████║
    ╚═══╝  ╚═╝╚═╝  ╚═╝   ╚═╝    ╚═════╝ ╚═╝  ╚═╝ ╚═════╝ ╚══════╝

  Version 1.0.4  •  Powered by Debian 13 Trixie  •  x86_64

ISSUE

# ── /etc/issue.net (shown for SSH) ───────────────────────────────────────────
cat > /etc/issue.net <<'ISSUENET'
VirtuaOS 1.0.4 — Powered by Debian 13 Trixie
Web Panel: http://<IP>:8441
ISSUENET

# ── /etc/motd (shown after login) ────────────────────────────────────────────
# Dynamic MOTD is handled by /etc/profile.d/virtuaos.sh
# Static motd is minimal
cat > /etc/motd <<'MOTD'
MOTD

echo "[VirtuaOS] Branding applied."
